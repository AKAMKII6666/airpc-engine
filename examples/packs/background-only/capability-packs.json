{
  "id": "example-background-only",
  "name": "Example Background Only",
  "version": "1.0.0",
  "apiVersion": 1,
  "enabled": false,
  "background": {
    "enabled": true,
    "pipelines": [
      {
        "slot": "tasks.onTick",
        "entry": "./onTick.mjs"
      },
      {
        "slot": "outbound.request",
        "entry": "./requestOutbound.mjs"
      }
    ]
  }
}
