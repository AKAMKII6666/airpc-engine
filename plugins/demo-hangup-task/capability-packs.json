{
  "id": "demo-hangup-task",
  "name": "Demo Hangup Task",
  "version": "1.0.0",
  "apiVersion": 1,
  "enabled": false,
  "realtime": {
    "enabled": true,
    "pipelines": [
      {
        "slot": "call.afterHangup",
        "entry": "./onHangup.mjs"
      }
    ]
  },
  "background": {
    "enabled": true,
    "pipelines": [
      {
        "slot": "tasks.onTick",
        "entry": "./onTick.mjs"
      },
      {
        "slot": "outbound.request",
        "entry": "./requestOutbound.mjs"
      }
    ]
  }
}
